# Público: Client ID OAuth do tipo Aplicativo da Web (frontend GIS)
VITE_GOOGLE_CLIENT_ID=

# Servidor: mesmo Client ID, validado pelo backend
GOOGLE_CLIENT_ID=

# Servidor: segredo aleatório forte (mínimo 32 bytes)
SESSION_SECRET=

# Redis REST compatível com Upstash/Vercel, obrigatório em produção
KV_REST_API_URL=
KV_REST_API_TOKEN=
